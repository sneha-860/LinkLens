{
  "name": "@linklens/eval",
  "version": "0.0.0",
  "private": true,
  "description": "LinkLens evaluation experiments E1–E8",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e": "tsx src/cli.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "sizes": "tsx bench/artefact-sizes.ts",
    "corpus": "tsx src/corpus-cli.ts",
    "lsh": "tsx src/lsh-cli.ts",
    "proxy": "tsx src/proxy-cli.ts",
    "l13": "tsx src/l13-cli.ts"
  },
  "dependencies": {
    "@linklens/api": "workspace:^",
    "@linklens/core": "workspace:*",
    "@linklens/counterfactual": "workspace:^",
    "@linklens/crawler": "workspace:^",
    "@linklens/db": "workspace:^",
    "@linklens/embeddings": "workspace:^",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2"
  }
}
