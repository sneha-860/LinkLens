{
  "name": "@linklens/api",
  "version": "0.0.0",
  "private": true,
  "description": "LinkLens HTTP API (Express)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@linklens/core": "workspace:*",
    "@linklens/counterfactual": "workspace:^",
    "@linklens/crawler": "workspace:^",
    "@linklens/db": "workspace:^",
    "@linklens/embeddings": "workspace:^",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "ioredis": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2"
  }
}
