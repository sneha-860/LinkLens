DATABASE_URL=postgres://linklens:linklens@localhost:5433/linklens
REDIS_URL=redis://localhost:6379

# The User-Agent every crawl request sends. Before auditing sites you do not own, set it to your
# own crawler name, a version and an https page where site owners can reach you, e.g.
#   LINKLENS_USER_AGENT=MyAuditBot/1.0 (+https://example.org/about-my-crawler)
# Without it, the built-in default (the project's repository page) is sent.
# LINKLENS_USER_AGENT=
